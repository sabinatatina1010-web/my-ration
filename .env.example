# Application
APP_NAME="Мой рацион"
# Локально часто :3001, если :3000 занят. В проде — HTTPS-домен.
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Database (PostgreSQL)
# Локально без установки Postgres:
#   1) npx prisma dev --detach --name my-ration
#   2) npx prisma dev ls  → скопируйте TCP / shadow ports
# На Windows используйте 127.0.0.1 вместо localhost.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51214/template1?sslmode=disable&connection_limit=1&connect_timeout=10"
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:51215/template1?sslmode=disable&connection_limit=1&connect_timeout=10"

# Auth.js — сгенерируйте: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="replace-with-long-random-string"
AUTH_URL="http://localhost:3001"

# OpenAI — обязателен для AI-фотодневника (Этап 7) и AI-помощника (Этап 9)
OPENAI_API_KEY=""
