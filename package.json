{
  "name": "my-ration",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run unit:nutrition && npm run unit:assistant",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:check": "node scripts/check-db.mjs",
    "unit:nutrition": "tsx scripts/unit-nutrition.mjs",
    "unit:assistant": "tsx scripts/unit-assistant-prompt.mjs",
    "smoke:auth": "tsx scripts/smoke-auth.mjs",
    "smoke:profile": "tsx scripts/smoke-profile.mjs",
    "smoke:dashboard": "tsx scripts/smoke-dashboard.mjs",
    "smoke:diary": "tsx scripts/smoke-diary.mjs",
    "smoke:food-estimate": "tsx scripts/smoke-food-estimate.mjs",
    "smoke:weight-water": "tsx scripts/smoke-weight-water.mjs",
    "smoke:assistant": "tsx scripts/smoke-assistant.mjs",
    "smoke:all": "tsx scripts/smoke-all.mjs",
    "db:up": "prisma dev --detach --name my-ration",
    "db:down": "prisma dev stop my-ration",
    "db:ls": "prisma dev ls",
    "postinstall": "prisma generate",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.54.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
